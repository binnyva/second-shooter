# Cloud Functions params. Copy to functions/.env and fill in before deploying.
#
# The Cloudflare Realtime TURN key ID. It cannot mint credentials on its own —
# that needs CLOUDFLARE_TURN_API_TOKEN, which is a Secret Manager secret, never
# a file:
#
#   firebase functions:secrets:set CLOUDFLARE_TURN_API_TOKEN
#
# Both come from the Cloudflare dashboard: Realtime → TURN Keys.
CLOUDFLARE_TURN_TOKEN_ID=your_cloudflare_turn_key_id
