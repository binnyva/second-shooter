<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-feature android:name="android.hardware.camera.any" />

    <uses-permission android:name="android.permission.CAMERA" />
    <!-- Asked for on the first recording, not at launch. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- CameraSessionService: keeps the session going with the screen off. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CAMERA" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- Lets GalleryApps see installed galleries on Android 11+. Must stay in
         step with GalleryApps.queryIntents(): an undeclared query returns an
         empty list rather than failing, which looks like "no gallery apps".
         Deliberately narrow: no MAIN/LAUNCHER and no QUERY_ALL_PACKAGES. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.APP_GALLERY" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:mimeType="image/*" />
        </intent>
    </queries>

    <application
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:theme="@android:style/Theme.Material.NoActionBar">

        <!-- Portrait-locked like a camera viewfinder. Other config changes
             (dark mode, font size) recreate the activity on purpose: the
             camera, track and connection live in a ViewModel and survive it. -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:screenOrientation="portrait">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Session links, as in app.json: the web remote's URL opens the
                 remote screen when the app is installed. autoVerify only
                 succeeds once apps.binnyva.com's assetlinks.json lists this
                 package and signing key; until then Android asks (or opens
                 the browser), and the custom scheme always works. -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" android:host="apps.binnyva.com" android:pathPrefix="/second-shooter/s" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="secondshooter" android:host="s" />
            </intent-filter>
        </activity>

        <service
            android:name=".session.CameraSessionService"
            android:exported="false"
            android:foregroundServiceType="camera|microphone" />
    </application>
</manifest>
